# IM 服务测试环境配置
# 复制此文件为 .env 并修改实际值
# 优先级: 环境变量 > .env > 默认值

# IM 服务器
IM_HOST=localhost
IM_HTTP_PORT=80
IM_ADMIN_PORT=18080
IM_ADMIN_SECRET=123456

# 推送服务
PUSH_HOST=localhost
PUSH_PORT=8085
PUSH_ADMIN_PORT=8086

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=
MYSQL_DB=imdb

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017

# 集群测试
CLUSTER_NODE_IPS=
CLUSTER_AUTH_IP=
